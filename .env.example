# ── Client (Vite) ─────────────────────────────────────────────────────
# Optional: point a local dev build at a deployed API (defaults to
# same-origin /api in production builds; unset in dev = offline mode).
# VITE_API_BASE_URL=https://your-app.vercel.app/api

# ── Server (Vercel env vars — set in the Vercel dashboard, not committed) ──
# Railway Postgres connection string (Railway → Postgres service → Variables)
# DATABASE_URL=postgresql://user:password@host:port/railway

# Shared secret protecting the API. Anyone with this token can read/write
# blueprints. Generate one: openssl rand -hex 24
# API_TOKEN=

# ── Local migration runs ──────────────────────────────────────────────
# DATABASE_URL=... npm run db:migrate
